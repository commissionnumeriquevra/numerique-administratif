rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher";
    }

    function ownsSeat(workshopId, seatId) {
      return signedIn()
        && get(/databases/$(database)/documents/workshops/$(workshopId)/seats/$(seatId)).data.studentUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // Le rôle maître est créé manuellement par l'administrateur.
    }

    match /workshops/{workshopId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();

      match /seats/{seatId} {
        allow read: if signedIn();

        // Un apprenant anonyme peut réclamer une place encore libre.
        allow update: if signedIn() && (
          isTeacher()
          || (
            resource.data.claimed == false
            && request.resource.data.claimed == true
            && request.resource.data.studentUid == request.auth.uid
          )
          || ownsSeat(workshopId, seatId)
        );

        allow create, delete: if isTeacher();

        match /achievements/{achievementId} {
          allow read, write: if isTeacher() || ownsSeat(workshopId, seatId);
        }
      }
    }

    match /missions/{missionId} {
      allow read: if signedIn();
      allow create, delete: if isTeacher();
      allow update: if isTeacher()
        || (
          signedIn()
          && request.resource.data.workshopId == resource.data.workshopId
          && request.resource.data.seatId == resource.data.seatId
        );
    }

    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if isTeacher();
    }
  }
}
